{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiosque",
  "version": "0.1.2",
  "identifier": "fr.kiosque.reader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kiosque",
        "width": 1180,
        "height": 800,
        "minWidth": 520,
        "minHeight": 420,
        "center": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
